<ui:FluentWindow
  x:Class="Eq2Lfg.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:Eq2Lfg.App.ViewModels"
  Title="EQ2 LFG Monitor"
  Width="880"
  Height="640"
  MinWidth="520"
  MinHeight="400"
  d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen"
  mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Title="EQ2 LFG Monitor" Grid.Row="0" />

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="130" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!--  Nav rail  -->
      <StackPanel Grid.Column="0" Margin="0,8,0,0">
        <RadioButton
          Content="Matches"
          FontSize="14"
          IsChecked="{Binding SelectedTab, Converter={StaticResource IndexEquals}, ConverterParameter=0}"
          Style="{StaticResource NavButton}" />
        <RadioButton
          Content="Traffic"
          FontSize="14"
          IsChecked="{Binding SelectedTab, Converter={StaticResource IndexEquals}, ConverterParameter=1}"
          Style="{StaticResource NavButton}" />
        <RadioButton
          Content="Settings"
          FontSize="14"
          IsChecked="{Binding SelectedTab, Converter={StaticResource IndexEquals}, ConverterParameter=2}"
          Style="{StaticResource NavButton}" />
      </StackPanel>

      <!--  Matches view  -->
      <ScrollViewer
        Grid.Column="1"
        Padding="16,8"
        VerticalScrollBarVisibility="Auto"
        Visibility="{Binding SelectedTab, Converter={StaticResource IndexToVisibility}, ConverterParameter=0}">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Opportunities}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:OpportunityRow}">
                <Border Style="{StaticResource AlertCard}">
                  <StackPanel>
                    <Grid>
                      <TextBlock
                        FontWeight="SemiBold"
                        Foreground="#FFB74D"
                        Text="{Binding TitleText}"
                        TextWrapping="Wrap" />
                      <TextBlock
                        HorizontalAlignment="Right"
                        Foreground="{StaticResource SecondaryText}"
                        Text="{Binding AgeText}" />
                    </Grid>
                    <TextBlock
                      Margin="0,4,0,0"
                      Text="{Binding PlayersText}"
                      TextWrapping="Wrap" />
                    <TextBlock
                      Margin="0,2,0,0"
                      FontStyle="Italic"
                      Foreground="#7BD88F"
                      Text="{Binding OwnText}"
                      TextWrapping="Wrap"
                      Visibility="{Binding OwnText, Converter={StaticResource StringToVisibility}}" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                      <Button Command="{Binding CopyMessageCommand}" Content="Copy invite message" />
                      <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#7BD88F"
                        Text="Copied — paste it in chat"
                        Visibility="{Binding Copied, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock
                      Margin="0,4,0,0"
                      FontSize="11"
                      Foreground="{StaticResource SecondaryText}"
                      Text="{Binding SuggestedMessage}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl ItemsSource="{Binding Matches}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:MatchRow}">
                <Border Style="{StaticResource AlertCard}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                      Grid.Column="0"
                      Width="4"
                      Margin="0,2,10,2"
                      Background="{Binding CharacterRole, Converter={StaticResource RoleToBrush}}"
                      CornerRadius="2" />
                    <StackPanel Grid.Column="1">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock
                          FontSize="14"
                          FontWeight="SemiBold"
                          Text="{Binding CharacterDisplay}" />
                        <Border Style="{StaticResource Chip}" Background="{Binding CharacterRole, Converter={StaticResource RoleToBrush}}">
                          <TextBlock Style="{StaticResource ChipText}" Text="{Binding CharacterRole}" />
                        </Border>
                        <Border
                          Style="{StaticResource Chip}"
                          Background="#33FFFFFF">
                          <TextBlock
                            Style="{StaticResource ChipText}"
                            Foreground="White"
                            Text="{Binding Channel}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="{Binding Advertiser, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=": " /><Run Text="{Binding MessageText, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock
                        Margin="0,2,0,0"
                        Foreground="{StaticResource SecondaryText}"
                        Text="{Binding ReasonsText}" />
                      <TextBlock
                        Margin="0,2,0,0"
                        Foreground="{StaticResource SecondaryText}"
                        FontStyle="Italic"
                        Text="{Binding AlsoMatchesText}"
                        Visibility="{Binding AlsoMatchesText, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                    <TextBlock
                      Grid.Column="2"
                      VerticalAlignment="Top"
                      Foreground="{StaticResource SecondaryText}"
                      Text="{Binding AgeText}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            FontSize="14"
            Foreground="{StaticResource SecondaryText}"
            Text="No matches yet — watching for groups that need you."
            Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </ScrollViewer>

      <!--  Traffic view  -->
      <ScrollViewer
        Grid.Column="1"
        Padding="16,8"
        VerticalScrollBarVisibility="Auto"
        Visibility="{Binding SelectedTab, Converter={StaticResource IndexToVisibility}, ConverterParameter=1}">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Traffic}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:TrafficRow}">
                <Border Style="{StaticResource Card}" Padding="10,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <StackPanel Orientation="Horizontal">
                        <Border
                          Style="{StaticResource Chip}"
                          Margin="0"
                          Background="{Binding Kind, Converter={StaticResource KindToBrush}}">
                          <TextBlock Style="{StaticResource ChipText}" Text="{Binding KindText}" />
                        </Border>
                        <TextBlock
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          FontWeight="SemiBold"
                          Text="{Binding Speaker}" />
                        <TextBlock
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="{StaticResource SecondaryText}"
                          Text="{Binding Channel}" />
                      </StackPanel>
                      <TextBlock
                        Margin="0,4,0,0"
                        Text="{Binding MessageText}"
                        TextWrapping="Wrap" />
                      <TextBlock
                        Margin="0,2,0,0"
                        Foreground="{StaticResource SecondaryText}"
                        Text="{Binding DetailText}"
                        Visibility="{Binding DetailText, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                    <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Top"
                      Foreground="{StaticResource SecondaryText}"
                      Text="{Binding AgeText}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            FontSize="14"
            Foreground="{StaticResource SecondaryText}"
            Text="No LFG traffic seen yet."
            Visibility="{Binding HasNoTraffic, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </ScrollViewer>

      <!--  Settings view  -->
      <ScrollViewer
        Grid.Column="1"
        Padding="16,8"
        VerticalScrollBarVisibility="Auto"
        Visibility="{Binding SelectedTab, Converter={StaticResource IndexToVisibility}, ConverterParameter=2}">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left" DataContext="{Binding Settings}">

          <TextBlock Style="{StaticResource SectionHeader}" Text="Alerts" />
          <CheckBox Content="Windows toast notifications" IsChecked="{Binding ToastAlerts}" />
          <CheckBox Content="Sound chime" IsChecked="{Binding SoundAlerts}" />
          <CheckBox Content="Highlight new matches in the app" IsChecked="{Binding InAppAlerts}" />

          <TextBlock Style="{StaticResource SectionHeader}" Text="Matching" />
          <CheckBox
            Margin="0,0,0,6"
            Content="Match higher-level characters (they can mentor down)"
            IsChecked="{Binding AllowMentorDown}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
              Grid.Row="0"
              Grid.Column="0"
              Margin="0,0,12,6"
              VerticalAlignment="Center"
              Text="Repeat-alert cooldown (minutes)" />
            <TextBox
              Grid.Row="0"
              Grid.Column="1"
              Margin="0,0,0,6"
              Text="{Binding CooldownMinutes, UpdateSourceTrigger=LostFocus}" />
            <TextBlock
              Grid.Row="1"
              Grid.Column="0"
              Margin="0,0,12,6"
              VerticalAlignment="Center"
              Text="Level tolerance (levels outside range)" />
            <TextBox
              Grid.Row="1"
              Grid.Column="1"
              Margin="0,0,0,6"
              Text="{Binding LevelTolerance, UpdateSourceTrigger=LostFocus}" />
            <TextBlock
              Grid.Row="2"
              Grid.Column="0"
              Margin="0,0,12,6"
              VerticalAlignment="Center"
              Text="Census refresh interval (minutes)" />
            <TextBox
              Grid.Row="2"
              Grid.Column="1"
              Margin="0,0,0,6"
              Text="{Binding CensusRefreshMinutes, UpdateSourceTrigger=LostFocus}" />
            <TextBlock
              Grid.Row="3"
              Grid.Column="0"
              Margin="0,0,12,6"
              VerticalAlignment="Center"
              Text="Group opportunity: minimum players" />
            <TextBox
              Grid.Row="3"
              Grid.Column="1"
              Margin="0,0,0,6"
              Text="{Binding OpportunityMinPlayers, UpdateSourceTrigger=LostFocus}" />
            <TextBlock
              Grid.Row="4"
              Grid.Column="0"
              Margin="0,0,12,6"
              VerticalAlignment="Center"
              Text="Group opportunity: level spread" />
            <TextBox
              Grid.Row="4"
              Grid.Column="1"
              Margin="0,0,0,6"
              Text="{Binding OpportunityLevelSpread, UpdateSourceTrigger=LostFocus}" />
            <TextBlock
              Grid.Row="5"
              Grid.Column="0"
              Margin="0,0,12,6"
              VerticalAlignment="Center"
              Text="Group opportunity: minimum archetypes" />
            <TextBox
              Grid.Row="5"
              Grid.Column="1"
              Margin="0,0,0,6"
              Text="{Binding OpportunityMinArchetypes, UpdateSourceTrigger=LostFocus}" />
            <TextBlock
              Grid.Row="6"
              Grid.Column="0"
              Margin="0,0,12,6"
              VerticalAlignment="Center"
              Text="Group opportunity: post window (minutes)" />
            <TextBox
              Grid.Row="6"
              Grid.Column="1"
              Margin="0,0,0,6"
              Text="{Binding OpportunityWindowMinutes, UpdateSourceTrigger=LostFocus}" />
          </Grid>

          <TextBlock Style="{StaticResource SectionHeader}" Text="EQ2 directory" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding Eq2Directory, UpdateSourceTrigger=LostFocus}" />
            <Button
              Grid.Column="1"
              Margin="8,0,0,0"
              Command="{Binding DetectEq2DirectoryCommand}"
              Content="Detect" />
          </Grid>
          <TextBlock
            Margin="0,4,0,0"
            Foreground="{StaticResource SecondaryText}"
            Text="{Binding DetectResult}"
            TextWrapping="Wrap"
            Visibility="{Binding DetectResult, Converter={StaticResource StringToVisibility}}" />

          <TextBlock Style="{StaticResource SectionHeader}" Text="Census service ID (optional)" />
          <TextBlock
            Margin="0,0,0,6"
            Foreground="{StaticResource SecondaryText}"
            Text="Anonymous Census access is limited to ~10 lookups/minute. Register a free service ID at census.daybreakgames.com to lift the limit."
            TextWrapping="Wrap" />
          <TextBox Text="{Binding CensusServiceId, UpdateSourceTrigger=LostFocus}" />

          <TextBlock Style="{StaticResource SectionHeader}" Text="Available characters" />
          <TextBlock
            Margin="0,0,0,6"
            Foreground="{StaticResource SecondaryText}"
            Text="Untick an account or server to exclude everything under it."
            TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding AccountNodes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:AvailabilityNode}">
                <StackPanel Margin="0,2">
                  <CheckBox
                    Content="{Binding Label}"
                    FontWeight="SemiBold"
                    IsChecked="{Binding IsChecked}" />
                  <ItemsControl Margin="24,0,0,0" ItemsSource="{Binding Children}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:AvailabilityNode}">
                        <StackPanel Margin="0,2">
                          <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" />
                          <ItemsControl Margin="24,0,0,0" ItemsSource="{Binding Children}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="{x:Type vm:AvailabilityNode}">
                                <CheckBox
                                  Margin="0,2"
                                  Content="{Binding Label}"
                                  IsChecked="{Binding IsChecked}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Style="{StaticResource SectionHeader}" Text="Zones" />
          <TextBlock
            Margin="0,0,0,6"
            Foreground="{StaticResource SecondaryText}"
            Text="Abbreviations are comma-separated. Click Save zones to apply."
            TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding ZoneRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ZoneRow}">
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox
                    Grid.Column="0"
                    Margin="0,0,6,0"
                    Text="{Binding Name}" />
                  <TextBox
                    Grid.Column="1"
                    Margin="0,0,6,0"
                    Text="{Binding Abbreviations}" />
                  <TextBox
                    Grid.Column="2"
                    Margin="0,0,6,0"
                    Text="{Binding MinLevel}" />
                  <TextBox
                    Grid.Column="3"
                    Margin="0,0,6,0"
                    Text="{Binding MaxLevel}" />
                  <Button
                    Grid.Column="4"
                    Command="{Binding DataContext.RemoveZoneCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    Content="✕" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Margin="0,8,0,24" Orientation="Horizontal">
            <Button Command="{Binding AddZoneCommand}" Content="Add zone" />
            <Button
              Margin="8,0,0,0"
              Command="{Binding SaveZonesCommand}"
              Content="Save zones" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!--  Status strip  -->
    <Border
      Grid.Row="2"
      Padding="16,6"
      Background="#1AFFFFFF"
      BorderBrush="{StaticResource CardBorder}"
      BorderThickness="0,1,0,0">
      <Grid>
        <TextBlock
          FontSize="12"
          Foreground="{StaticResource SecondaryText}"
          Text="{Binding StatusText}" />
        <TextBlock
          HorizontalAlignment="Right"
          FontSize="12"
          Foreground="{StaticResource SecondaryText}"
          Text="{Binding CensusText}" />
      </Grid>
    </Border>
  </Grid>
</ui:FluentWindow>
